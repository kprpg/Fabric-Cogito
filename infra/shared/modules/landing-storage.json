        "logs": [
          {
            "categoryGroup": "allLogs",
            "enabled": true
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', format('{0}{1}', take(parameters('namePrefix'), 10), uniqueString(resourceGroup().id)), 'default')]"
      ]
    }
