      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', format('{0}{1}', take(parameters('namePrefix'), 10), uniqueString(resourceGroup().id)), 'default', 'landing'), parameters('dataPrincipalId'), 'Storage Blob Data Contributor')]",
      "properties": {
        "principalId": "[parameters('dataPrincipalId')]",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'ba92f5b4-2d11-453d-a403-e96b0029c9fe')]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
